# DevTrack environment template
# Copy to .env.local and fill in: cp .env.example .env.local
# Every value here is server-only. Nothing gets a NEXT_PUBLIC_ prefix.

# --- Database ---
# Postgres connection string. Built against Neon's free tier.
DATABASE_URL=

# --- Auth.js / GitHub OAuth ---
# From GitHub: Settings > Developer settings > OAuth Apps.
# Callback URL: http://localhost:3000/api/auth/callback/github
# Do not configure scopes on the app itself: sign-in asks for identity only and
# repo access is requested separately when a scan starts.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Session signing secret. Generate one with: npx auth secret
AUTH_SECRET=

# --- Model provider ---
# google (default) or groq. "gemini" is accepted as an alias for google.
AI_PROVIDER=google
AI_MODEL=gemini-3.6-flash
# Read directly by the provider SDK. Set the one matching AI_PROVIDER.
GOOGLE_GENERATIVE_AI_API_KEY=
# GROQ_API_KEY=

# --- Optional LinkedIn scraping path ---
# Off unless ENABLE_APIFY is exactly "true" and APIFY_TOKEN is set. Paid, and
# carries account risk under LinkedIn's terms. The default import path is the
# official profile export, which needs none of this.
ENABLE_APIFY=false
APIFY_TOKEN=
APIFY_LINKEDIN_ACTOR=dev_fusion~linkedin-profile-scraper
